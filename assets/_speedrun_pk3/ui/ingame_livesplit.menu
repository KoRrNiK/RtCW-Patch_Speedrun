		backcolor .1 .1 .1 0
		visible 1
		action { hide grpSrTimer ; hide grpSrSpeedo ; hide grpSrHud ; hide grpSrView ; show grpSrView }
		mouseEnter { setitemcolor ctr_view backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_view backcolor .37 .1 .1 1 }
	}

	itemDef {
		name srTimer_lrt
		group grpSrTimer
		type ITEM_TYPE_YESNO
		text "Show LRT:"
		cvar "cg_drawLRT"
