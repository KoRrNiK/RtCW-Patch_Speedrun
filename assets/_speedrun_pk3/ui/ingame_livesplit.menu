		textaligny 10
		forecolor 1 1 1 1
		backcolor .1 .1 .1 0
		visible 1
		action { hide grpSrTimer ; hide grpSrSpeedo ; hide grpSrHud ; hide grpSrView ; show grpSrSpeedo }
		mouseEnter { setitemcolor ctr_speedo backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_speedo backcolor .37 .1 .1 1 }
	}

	itemDef {
		name ctr_hud
		text "HUD"
