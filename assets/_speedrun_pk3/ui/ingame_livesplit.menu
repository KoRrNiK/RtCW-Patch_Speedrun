#include "ui/menudef.h"

{

menuDef {
	name "ingame_livesplit"
	visible 0
	fullscreen 0
	outOfBoundsClick
	rect 100 125 443 340
	focusColor 1 .75 0 1
	style 1
	border 1

	onopen { hide grpSrTimer ; hide grpSrSpeedo ; hide grpSrHud ; hide grpSrView ; show grpSrTimer }
	onEsc { close ingame_livesplit }

	itemDef {
		name window
		rect 0 2 443 300
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}

	itemDef {
		name window2
		rect 2 4 439 20
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .1 .1 .1 .2
		forecolor 1 1 1 1
		backcolor .3 .5 .2 .25
		visible 1
		decoration
	}

	itemDef {
		name ctr_timer
		text "Timer"
		type 1
		textscale .23
		rect 16 10 78 12
		textalign 1
		textalignx 39
		textaligny 10
		forecolor 1 1 1 1
		backcolor .1 .1 .1 0
		visible 1
		action { hide grpSrTimer ; hide grpSrSpeedo ; hide grpSrHud ; hide grpSrView ; show grpSrTimer }
		mouseEnter { setitemcolor ctr_timer backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_timer backcolor .37 .1 .1 1 }
	}

	itemDef {
		name ctr_speedo
		text "Speedo"
		type 1
		textscale .23
