// ========================================
//  BACK button (always visible)
// ========================================

	itemDef {
		name back_btn
		text "BACK"
		type 1
		textscale .22
		rect 8 426 50 18
		textalign ITEM_ALIGN_LEFT
		textalignx 0
		textaligny 14
		forecolor .85 .88 .80 .80
		visible 1
		action { close setup_livesplit }
		mouseEnter { setitemcolor back_btn forecolor .75 .95 .55 1 }
		mouseExit { setitemcolor back_btn forecolor .85 .88 .80 .80 }
	}

}

