		rect 8 5 200 14
		textalign ITEM_ALIGN_LEFT
		textalignx 0
		textaligny 12
		textscale .19
		forecolor .45 .70 .30 .70
		visible 1
		decoration
	}

	// ==== Right-side tab panel background ====
