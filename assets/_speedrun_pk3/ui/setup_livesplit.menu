#include "ui/menudef.h"

{

menuDef {
	name "setup_livesplit"
	visible 0
	fullscreen 0
	outOfBoundsClick
	rect 60 10 520 470
	focusColor .75 .95 .55 1
	style 1
	border 1

	onEsc { close setup_livesplit }
	onopen { hide grpLivesplit ; show lsTimer }

	// ==== Background panel ====
	itemDef {
		name window
		rect 0 0 520 445
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .22 .38 .12 .45
		forecolor 1 1 1 1
		backcolor .04 .04 .06 .94
		visible 1
		decoration
	}

	// ==== Top accent bar ====
	itemDef {
		name topbar
		rect 1 1 518 2
		style WINDOW_STYLE_FILLED
		backcolor .25 .65 .18 .55
		visible 1
		decoration
	}

	itemDef {
		name bottombar
		rect 1 442 518 2
		style WINDOW_STYLE_FILLED
		backcolor .25 .65 .18 .55
		visible 1
		decoration
	}

	// ==== Title bar ====
	itemDef {
		name titlebar
		rect 1 3 518 18
		style WINDOW_STYLE_FILLED
		backcolor .06 .08 .04 .80
		visible 1
		decoration
	}
