	// Start
	itemDef {
		name lsActions
		group grpLivesplit
		type 1
		text "Start Run"
		rect 20 52 185 22
		textalign 1
		textalignx 92
		textaligny 16
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor .10 .20 .06 .50
		forecolor .85 .95 .80 1
		border 1
		bordercolor .22 .38 .12 .45
		visible 0
		action { exec "livesplit_start" }
		mouseEnter { setitemcolor lsActions backcolor .15 .30 .10 .80 }
		mouseExit { setitemcolor lsActions backcolor .10 .20 .06 .50 }
	}

