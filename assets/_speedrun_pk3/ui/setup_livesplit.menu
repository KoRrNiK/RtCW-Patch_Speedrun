	// -- Demo list --
	itemDef {
		name demolist
		group grpLivesplit
		name lsDemos
		rect 12 46 396 330
		type ITEM_TYPE_LISTBOX
		style WINDOW_STYLE_FILLED
		elementwidth 380
		elementheight 16
		textscale .20
		elementtype LISTBOX_TEXT
		feeder FEEDER_DEMOS
		textalign 3
		textaligny 12
		forecolor .85 .90 .80 .85
		backcolor .08 .10 .06 .40
		outlinecolor .25 .45 .15 .20
		border 1
		bordercolor .22 .38 .12 .30
		visible 0
		doubleClick { uiScript RunDemo }
		mouseEnter { setitemcolor demolist bordercolor .45 .70 .30 .60 }
		mouseExit { setitemcolor demolist bordercolor .22 .38 .12 .30 }
	}

	// -- Play button --
	itemDef {
		name lsDemos
		group grpLivesplit
