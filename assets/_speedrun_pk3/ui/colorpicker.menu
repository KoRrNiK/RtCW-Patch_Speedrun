#include "ui/menudef.h"

// ========================================
//  Color Picker popup menu
//  Single ownerdraw covers the full screen - handles all
//  rendering (dim backdrop + wheel) and input in C code.
//  Click outside the wheel or press ESC/RMB to close.
// ========================================

{
	menuDef {
		name "colorpicker"
		visible 0
		fullscreen 0
		rect 0 0 640 480
		focusColor 1 1 1 1
		style WINDOW_STYLE_EMPTY
		popup
		onESC { close colorpicker }

		// Single ownerdraw item - covers full screen so it always gets focus.
		// The C draw function renders the picker panel.
		// The C key handler closes on click outside wheel.
		itemDef {
			name cpick_wheel
			rect 0 0 640 480
			scralign center
			type ITEM_TYPE_OWNERDRAW
			ownerdraw 283
			visible 1
		}
	}
}
